# Runtime
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://rag:rag@localhost:5432/rag_kb
PGVECTOR_INDEX_LISTS=100

# Redis and queues
REDIS_URL=redis://localhost:6379
INGESTION_QUEUE_NAME=document-ingestion
LLM_QUEUE_NAME=llm-answer

# Authentication and tenancy
# JWT_SECRET must be ≥32 characters — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-minimum-32-character-random-secret-here
JWT_ISSUER=rag-knowledge-base-api
JWT_AUDIENCE=rag-clients
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_PUBLIC_KEY_BASE64=replace-with-base64-public-key
JWT_PRIVATE_KEY_BASE64=replace-with-base64-private-key

# LLM providers
USE_MOCKS=true
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_CHAT_MODEL=llama3
OPENAI_EMBEDDING_MODEL=nomic-embed-text
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-latest
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Retrieval
VECTOR_PROVIDER=pgvector
PINECONE_API_KEY=replace-me
PINECONE_INDEX=rag-knowledge-base
DEFAULT_TOP_K=8
MAX_CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# Security and controls
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
TENANT_MONTHLY_TOKEN_BUDGET=5000000
PII_REDACTION_ENABLED=true

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
METRICS_ENABLED=true
